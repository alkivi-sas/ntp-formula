{% set map = {
    'Arch': {
        'client': 'ntp',
        'server': 'ntp',
        'service': 'ntpd',
        'ntpdate': 'ntpdate',

        'ntp_conf': '/etc/ntp.conf',
        'ntpd_conf': '/etc/ntpd.conf',
    },
    'Debian': {
        'client': 'ntp',
        'server': 'ntpd',
        'service': 'ntp',
        'ntpdate': 'ntpdate',

        'ntp_conf': '/etc/ntp.conf',
        'ntpd_conf': '/etc/ntpd.conf',
    },
    'FreeBSD': {
        'client': 'ntp',
        'server': 'ntpd',
        'service': 'ntpd',
        'ntpdate': 'ntpdate',

        'ntp_conf': '/etc/ntp.conf',
        'ntpd_conf': '/usr/local/etc/ntpd.conf',
    },
    'RedHat': {
        'client': 'ntp',
        'server': 'ntpd',
        'service': 'ntpd',
        'ntpdate': 'ntpdate',

        'ntp_conf': '/etc/ntp.conf',
        'ntpd_conf': '/etc/ntpd.conf',
    },
    'Suse': {
        'client': 'ntp',
        'server': 'ntp',
        'service': salt['grains.filter_by']({
            '11.3': 'ntp',
            '11.4': 'ntp',
            'default': 'ntpd',
        }, grain='osrelease'),
        'ntpdate': 'ntpdate',

        'ntp_conf': '/etc/ntp.conf',
        'ntpd_conf': '/etc/ntpd.conf',
    },
} %}

{% if grains['os'] == 'Debian' and grains['osmajorrelease']|int >= 13 %}
{% do map['Debian'].update({
    'client': 'ntpsec',
    'service': 'ntpsec',
    'ntp_conf': '/etc/ntpsec/ntp.conf',
    'driftfile': '/var/lib/ntpsec/ntp.drift',
}) %}
{% endif %}

{% set ntp = salt['grains.filter_by'](map, merge=salt['pillar.get']('ntp:lookup')) %}
